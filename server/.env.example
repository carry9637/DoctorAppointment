# Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server Port
PORT=5000

# JWT Secret Key (Use a strong secret)
JWT_SECRET=your_jwt_secret_key_here_make_it_strong_and_random

# MongoDB Connection String
# For local MongoDB:
# MONGO_URI=mongodb://localhost:27017/doctorApp
#
# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/?appName=Cluster0

# Environment
NODE_ENV=development

# Email Configuration (Optional - for password reset emails)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Optional: Cloudinary for image uploads
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
